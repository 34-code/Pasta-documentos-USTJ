<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>User Login</title>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Raleway', sans-serif;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, #b8c8e8 0%, #c8aed4 50%, #e8a8c0 100%);
    overflow: hidden;
  }

  /* ── SCREENS ── */
  .screen { display: none; width: 100%; height: 100vh; }
  .screen.active { display: flex; align-items: center; justify-content: center; }

  /* ── DASHBOARD SCREEN ── */
  #dashScreen {
    position: relative;
    background: #000;
    animation: fadeIn .6s ease;
  }

  #dashScreen img.bg {
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: .92;
  }

  .dash-overlay {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    justify-content: flex-start; padding: 28px 36px;
    background: linear-gradient(to bottom, rgba(0,0,0,.55) 0%, transparent 40%);
  }

  .dash-bar {
    display: flex; align-items: center; justify-content: space-between;
  }

  .dash-brand {
    font-size: 1.1rem; font-weight: 600;
    color: #fff; letter-spacing: .06em; text-transform: uppercase;
  }

  .btn-logout {
    padding: 7px 20px;
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.45);
    border-radius: 6px;
    color: #fff; font-family: 'Raleway', sans-serif;
    font-size: .8rem; font-weight: 500;
    letter-spacing: .08em; text-transform: uppercase;
    cursor: pointer; transition: background .2s;
    backdrop-filter: blur(6px);
  }
  .btn-logout:hover { background: rgba(255,255,255,.3); }

  .welcome-badge {
    position: absolute; bottom: 36px; left: 36px;
    background: rgba(255,255,255,.18);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,.35);
    border-radius: 12px;
    padding: 16px 24px;
    color: #fff;
  }
  .welcome-badge p:first-child { font-size: .7rem; opacity: .75; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 4px; }
  .welcome-badge p:last-child  { font-size: 1.05rem; font-weight: 600; }

  /* ── CARD ── */
  .card {
    background: rgba(255,255,255,0.28);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.55);
    border-radius: 16px;
    padding: 48px 44px 40px;
    width: 360px;
    box-shadow: 0 20px 60px rgba(120,100,160,0.2);
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute; top: -60px; left: -60px;
    width: 200px; height: 200px;
    background: rgba(255,255,255,0.15);
    border-radius: 50%; pointer-events: none;
  }

  h1 {
    text-align: center; font-size: 1.55rem; font-weight: 600;
    color: #3a3560; letter-spacing: .04em; margin-bottom: 36px;
  }

  .field { position: relative; margin-bottom: 6px; }

  .field svg.icon {
    position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    width: 15px; height: 15px; color: #7a6ea0; pointer-events: none;
  }

  .field input {
    width: 100%; background: transparent;
    border: none; border-bottom: 1.5px solid rgba(100,80,160,0.3);
    padding: 10px 36px 10px 26px;
    font-family: 'Raleway', sans-serif; font-size: .88rem; color: #3a3560;
    outline: none; transition: border-color .25s;
  }
  .field input::placeholder { color: rgba(90,70,140,0.45); }
  .field input:focus        { border-bottom-color: #3a3560; }
  .field input.error        { border-bottom-color: #e05070; }

  .char-hint {
    position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    font-size: .67rem; color: rgba(90,70,140,0.4); pointer-events: none; transition: color .2s;
  }
  .char-hint.full { color: #3a3560; }

  .err-msg {
    font-size: .7rem; color: #e05070; min-height: 16px;
    display: block; padding-left: 26px; margin-bottom: 10px;
  }

  .row {
    display: flex; align-items: center; justify-content: space-between;
    margin: 10px 0 28px;
  }
  .remember {
    display: flex; align-items: center; gap: 7px;
    font-size: .74rem; color: #5a4e8a; cursor: pointer;
  }
  .remember input[type="checkbox"] { accent-color: #3a3560; width: 13px; height: 13px; }

  .forgot {
    font-size: .74rem; color: #5a4e8a; cursor: pointer; transition: color .2s;
    position: relative;
  }
  .forgot::after {
    content: ''; position: absolute; left: 0; bottom: -2px;
    width: 0; height: 1px; background: #3a3560; transition: width .25s;
  }
  .forgot:hover { color: #3a3560; }
  .forgot:hover::after { width: 100%; }

  .btn-login {
    display: block; width: 100%; padding: 12px;
    background: #3a3560; color: #fff; border: none; border-radius: 6px;
    font-family: 'Raleway', sans-serif; font-size: .88rem; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase; cursor: pointer;
    transition: background .2s, transform .15s, box-shadow .2s;
    box-shadow: 0 4px 18px rgba(58,53,96,0.3);
  }
  .btn-login:hover  { background: #4e4880; transform: translateY(-1px); box-shadow: 0 8px 24px rgba(58,53,96,0.35); }
  .btn-login:active { transform: translateY(0); }

  /* ── OVERLAYS ── */
  .overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(80,60,120,0.32); backdrop-filter: blur(6px);
    z-index: 50; align-items: center; justify-content: center;
  }
  .overlay.open { display: flex; animation: fadeIn .3s ease; }

  @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }

  .modal {
    background: rgba(255,255,255,0.65); backdrop-filter: blur(22px);
    border: 1px solid rgba(255,255,255,0.75); border-radius: 14px;
    padding: 40px 36px 32px; width: 320px;
    box-shadow: 0 24px 60px rgba(80,60,120,0.22);
    animation: slideUp .3s ease;
  }
  @keyframes slideUp {
    from { opacity:0; transform: translateY(22px); }
    to   { opacity:1; transform: translateY(0); }
  }

  .modal h2 { font-size: 1.15rem; font-weight: 600; color: #3a3560; margin-bottom: 7px; }
  .modal > p { font-size: .78rem; color: #7a6ea0; margin-bottom: 22px; line-height: 1.55; }

  .modal-actions { display: flex; gap: 10px; margin-top: 18px; }

  .btn-send {
    flex: 1; padding: 11px; background: #3a3560; color: #fff;
    border: none; border-radius: 6px;
    font-family: 'Raleway', sans-serif; font-size: .82rem; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase; cursor: pointer; transition: background .2s;
  }
  .btn-send:hover { background: #4e4880; }

  .btn-cancel {
    flex: 1; padding: 11px; background: transparent; color: #7a6ea0;
    border: 1px solid rgba(100,80,160,0.3); border-radius: 6px;
    font-family: 'Raleway', sans-serif; font-size: .82rem; font-weight: 500;
    cursor: pointer; transition: border-color .2s, color .2s;
  }
  .btn-cancel:hover { border-color: #3a3560; color: #3a3560; }

  .modal.success { text-align: center; padding: 44px 36px 36px; }
  .check-circle {
    width: 58px; height: 58px; border-radius: 50%;
    background: rgba(58,53,96,0.1);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 18px;
  }
  .check-circle svg { width: 26px; height: 26px; color: #3a3560; }
  .modal.success h2 { font-size: 1.25rem; margin-bottom: 9px; }
  .modal.success p  { margin-bottom: 26px; font-size: .8rem; color: #7a6ea0; line-height: 1.5; }
  .btn-ok {
    padding: 11px 36px; background: #3a3560; color: #fff;
    border: none; border-radius: 6px;
    font-family: 'Raleway', sans-serif; font-size: .82rem; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase; cursor: pointer; transition: background .2s;
  }
  .btn-ok:hover { background: #4e4880; }
</style>
</head>
<body>

<!-- ══════════ LOGIN SCREEN ══════════ -->
<div class="screen active" id="loginScreen">
  <div class="card">
    <h1>User Login</h1>

    <div class="field">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <input type="email" id="email" placeholder="Email ID" autocomplete="email"/>
    </div>
    <span class="err-msg" id="emailErr"></span>

    <div class="field">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <input type="password" id="password" placeholder="Password" maxlength="8" autocomplete="current-password"/>
      <span class="char-hint" id="charHint">0/8</span>
    </div>
    <span class="err-msg" id="passErr"></span>

    <div class="row">
      <label class="remember"><input type="checkbox" id="remember"/> Remember me</label>
      <span class="forgot" onclick="openForgot()">Forgot Password?</span>
    </div>

    <button class="btn-login" onclick="handleLogin()">LOGIN</button>
  </div>
</div>

<!-- ══════════ DASHBOARD SCREEN ══════════ -->
<div class="screen" id="dashScreen">
  <img class="bg" id="dashBg" src="" alt="Dashboard"/>
  <div class="dash-overlay">
    <div class="dash-bar">
      <span class="dash-brand">Painel de Obras</span>
      <button class="btn-logout" onclick="handleLogout()">Sair</button>
    </div>
  </div>
  <div class="welcome-badge">
    <p>Bem-vindo</p>
    <p id="welcomeName">—</p>
  </div>
</div>

<!-- ══════════ FORGOT MODAL ══════════ -->
<div class="overlay" id="forgotOverlay">
  <div class="modal">
    <h2>Esqueci minha senha</h2>
    <p>Digite seu e-mail e enviaremos as instruções para redefinir sua senha.</p>
    <div class="field">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <input type="email" id="recoverEmail" placeholder="seu@email.com"/>
    </div>
    <span class="err-msg" id="recoverErr"></span>
    <div class="modal-actions">
      <button class="btn-send" onclick="handleRecover()">Enviar</button>
      <button class="btn-cancel" onclick="closeForgot()">Cancelar</button>
    </div>
  </div>
</div>

<!-- ══════════ SUCCESS MODAL ══════════ -->
<div class="overlay" id="successOverlay">
  <div class="modal success">
    <div class="check-circle">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 2 11 13"/><path d="M22 2 15 22 11 13 2 9l20-7z"/>
      </svg>
    </div>
    <h2>E-mail enviado!</h2>
    <p>Verifique sua caixa de entrada e siga as instruções para redefinir sua senha.</p>
    <button class="btn-ok" onclick="closeSuccess()">OK</button>
  </div>
</div>

<script>
  /* ── embed the construction image as base64 ── */
  const DASH_IMG = '';
  document.getElementById('dashBg').src = 'data:image/jpeg;base64,' + DASH_IMG;

  /* ── char counter ── */
  const passInput = document.getElementById('password');
  const charHint  = document.getElementById('charHint');
  passInput.addEventListener('input', () => {
    const len = passInput.value.length;
    charHint.textContent = len + '/8';
    charHint.classList.toggle('full', len === 8);
    document.getElementById('passErr').textContent = '';
    passInput.classList.remove('error');
  });

  document.getElementById('email').addEventListener('input', () => {
    document.getElementById('emailErr').textContent = '';
    document.getElementById('email').classList.remove('error');
  });

  /* ── login ── */
  function handleLogin() {
    const email = document.getElementById('email');
    const pass  = document.getElementById('password');
    let ok = true;

    if (!email.value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
      document.getElementById('emailErr').textContent = 'Por favor, insira um e-mail válido.';
      email.classList.add('error'); ok = false;
    }
    if (pass.value.length !== 8) {
      document.getElementById('passErr').textContent = 'A senha deve ter exatamente 8 caracteres.';
      pass.classList.add('error'); ok = false;
    }
    if (!ok) return;

    document.getElementById('welcomeName').textContent = email.value;
    document.getElementById('loginScreen').classList.remove('active');
    document.getElementById('dashScreen').classList.add('active');
  }

  function handleLogout() {
    document.getElementById('email').value = '';
    document.getElementById('password').value = '';
    charHint.textContent = '0/8';
    charHint.classList.remove('full');
    document.getElementById('dashScreen').classList.remove('active');
    document.getElementById('loginScreen').classList.add('active');
  }

  /* ── forgot ── */
  function openForgot() {
    document.getElementById('recoverEmail').value = '';
    document.getElementById('recoverErr').textContent = '';
    document.getElementById('recoverEmail').classList.remove('error');
    document.getElementById('forgotOverlay').classList.add('open');
  }
  function closeForgot() { document.getElementById('forgotOverlay').classList.remove('open'); }

  function handleRecover() {
    const rec = document.getElementById('recoverEmail');
    if (!rec.value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(rec.value)) {
      document.getElementById('recoverErr').textContent = 'Por favor, insira um e-mail válido.';
      rec.classList.add('error'); return;
    }
    closeForgot();
    document.getElementById('successOverlay').classList.add('open');
  }

  function closeSuccess() { document.getElementById('successOverlay').classList.remove('open'); }

  document.getElementById('forgotOverlay').addEventListener('click', e => { if (e.target===e.currentTarget) closeForgot(); });
  document.getElementById('successOverlay').addEventListener('click', e => { if (e.target===e.currentTarget) closeSuccess(); });
</script>
</body>
</html>
